// Domain vocabulary: see GLOSSARY.md. Decisions: docs/adr/.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Connection strings come from prisma.config.ts (migrations) and the
// @prisma/adapter-pg driver adapter (runtime). See ADR-0006.
datasource db {
  provider = "postgresql"
}

/// Where a Task is in the workflow. Fixed set, one column each.
enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

/// In display order. Every change stores the final value (ADR-0004).
enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityKind {
  TASK_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  LABELS_CHANGED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  COMMENT_ADDED
  COMMENT_ARCHIVED
}

model Task {
  id          String      @id @default(uuid(7)) @db.Uuid
  title       String      @db.VarChar(120)
  description String      @default("") @db.VarChar(2000)
  status      Status      @default(TODO)
  /// Fractional-index key (ADR-0001), ordered within a Status. The column uses
  /// COLLATE "C" (set in the migration SQL, ADR-0006). Ties are broken by id.
  rank        String
  priority    Priority    @default(NONE)
  assigneeId  String?     @db.Uuid
  assignee    TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels      Label[]
  comments    Comment[]
  activities  Activity[]
  /// Archived Tasks are kept but never shown on the Board (ADR-0002).
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, rank, id])
}

model Label {
  id       String @id
  name     String @unique
  /// Colour token, mapped to a palette in the UI.
  color    String
  position Int    @unique
  tasks    Task[]
}

model TeamMember {
  id       String    @id @default(uuid(7)) @db.Uuid
  name     String    @unique
  /// Colour token for the avatar, mapped to a palette in the UI.
  color    String
  position Int       @unique
  tasks    Task[]
  comments Comment[]
}

model Guest {
  id         String     @id @default(uuid(7)) @db.Uuid
  name       String
  /// Colour token for the avatar, mapped to a palette in the UI.
  color      String
  createdAt  DateTime   @default(now())
  comments   Comment[]
  activities Activity[]
}

/// Written by a Guest, or by a Team Member for seed data. Exactly one author
/// is set (CHECK constraint in the migration SQL).
model Comment {
  id                 String      @id @default(uuid(7)) @db.Uuid
  taskId             String      @db.Uuid
  task               Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  body               String      @db.VarChar(1000)
  authorGuestId      String?     @db.Uuid
  authorGuest        Guest?      @relation(fields: [authorGuestId], references: [id], onDelete: Restrict)
  authorTeamMemberId String?     @db.Uuid
  authorTeamMember   TeamMember? @relation(fields: [authorTeamMemberId], references: [id], onDelete: Restrict)
  /// Archived Comments disappear from the Task but are kept (ADR-0002).
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())

  @@index([taskId, createdAt])
}

/// Append-only record of a meaningful change to a Task.
model Activity {
  id        String       @id @default(uuid(7)) @db.Uuid
  taskId    String       @db.Uuid
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  guestId   String       @db.Uuid
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Restrict)
  kind      ActivityKind
  from      Json?
  to        Json?
  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
}

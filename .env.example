# Copy to .env.local (gitignored) and fill in. See ADR-0006 and the README.
# Never put production credentials here: they live only in Vercel's Production scope.

# --- Database: dev ---------------------------------------------------------
# Used by `pnpm dev` and the seed/reset scripts.
# Pooled connection, used by the app at runtime (on Neon the host contains "-pooler").
DATABASE_URL=postgresql://user:password@dev-host-pooler.example.com/kanban?sslmode=require
# Direct (non-pooled) connection, used by Prisma migrations.
DIRECT_URL=postgresql://user:password@dev-host.example.com/kanban?sslmode=require

# --- Database: test --------------------------------------------------------
# A disposable database. Integration tests wipe it; Playwright tests reseed it.
TEST_DATABASE_URL=postgresql://user:password@test-host-pooler.example.com/kanban?sslmode=require
TEST_DIRECT_URL=postgresql://user:password@test-host.example.com/kanban?sslmode=require

# --- Guard -----------------------------------------------------------------
# Hostname of the production database only, no credentials (not a secret).
# Scripts and tests refuse to run against it, and refuse to run if it's unset.
PRODUCTION_DATABASE_HOST=prod-host-pooler.example.com
